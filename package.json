{
  "name": "cmz-mcp",
  "version": "1.0.0",
  "description": "Standalone Model Context Protocol (MCP) server for ConnectMasjid (CMZ)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cmz-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test 'src/*.test.ts' 'src/**/*.test.ts'",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prayer-times",
    "connectmasjid",
    "cmz"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
